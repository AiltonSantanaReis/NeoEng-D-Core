@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost 1.80 CONFIG)
# NEOENG_WINDOWS_CLANG_RT_PACKAGE_BEGIN
# O target exportado NeoEng::DCore preserva uma dependência link-only
# do compiler-rt usado pelo clang-cl. O pacote consumidor precisa
# reconstruir esse target antes de importar NeoEngDCoreTargets.cmake.
if(WIN32 AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    if(NOT TARGET neoeng_clang_rt_builtins)
        execute_process(
            COMMAND "${CMAKE_CXX_COMPILER}" --print-resource-dir
            OUTPUT_VARIABLE _neoeng_clang_resource_dir
            OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE _neoeng_clang_resource_result
            ERROR_QUIET
        )

        if(
            NOT _neoeng_clang_resource_result EQUAL 0
            OR _neoeng_clang_resource_dir STREQUAL ""
        )
            message(
                FATAL_ERROR
                "NeoEngDCore could not determine the clang resource directory"
            )
        endif()

        unset(_neoeng_clang_rt_builtins_path CACHE)

        find_library(
            _neoeng_clang_rt_builtins_path
            NAMES
                clang_rt.builtins-x86_64
                clang_rt.builtins
            HINTS
                "${_neoeng_clang_resource_dir}/lib/windows"
            NO_DEFAULT_PATH
        )

        if(NOT _neoeng_clang_rt_builtins_path)
            message(
                FATAL_ERROR
                "NeoEngDCore could not locate clang compiler-rt builtins"
            )
        endif()

        add_library(
            neoeng_clang_rt_builtins
            UNKNOWN
            IMPORTED
        )

        set_target_properties(
            neoeng_clang_rt_builtins
            PROPERTIES
                IMPORTED_LOCATION
                    "${_neoeng_clang_rt_builtins_path}"
        )
    endif()
endif()
# NEOENG_WINDOWS_CLANG_RT_PACKAGE_END
include("${CMAKE_CURRENT_LIST_DIR}/NeoEngDCoreTargets.cmake")
check_required_components(NeoEngDCore)
