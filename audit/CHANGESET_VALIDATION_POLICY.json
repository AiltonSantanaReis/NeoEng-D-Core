{
  "schema": "neoeng.dcore.changeset-validation-policy.v1",
  "policy_id": "NEOENG-DCORE-CHANGESET-VALIDATION-001",
  "purpose": "CS001-CS015-style evidence-driven ChangeSet validation with exact GitHub run binding and fail-closed acceptance.",
  "lifecycle_states": ["PLANNED", "IMPLEMENTED", "VALIDATED", "ACCEPTED"],
  "terminal_nonacceptance_states": ["FAILED", "BLOCKED"],
  "test_result_states": ["PASS", "FAIL", "SKIPPED", "NOT_TESTED", "BLOCKED", "PARTIAL"],
  "ci_green_is_acceptance": false,
  "required_test_nonpass_blocks_validation": true,
  "test_inventory_frozen_before_execution": true,
  "allow_test_removal_after_execution": false,
  "exact_run_binding_required": true,
  "required_run_fields": ["source_sha", "run_id", "run_attempt", "workflow_path"],
  "failure_preservation_required": true,
  "accepted_requires_validated": true,
  "all_required_tests_must_pass": true,
  "candidate_verifier_is_authoritative": false,
  "trusted_base_verifier_required_for_pr_acceptance": true,
  "single_maintainer_human_approval_required": false,
  "historical_records_are_immutable": true,
  "release_is_separate_from_changeset_acceptance": true,
  "prohibited_acceptance_shortcuts": [
    "CI_GREEN_ONLY",
    "MISSING_REQUIRED_TEST",
    "REQUIRED_TEST_SKIPPED",
    "REQUIRED_TEST_NOT_TESTED",
    "REQUIRED_TEST_PARTIAL",
    "REQUIRED_TEST_BLOCKED",
    "REQUIRED_TEST_FAILED",
    "TEST_INVENTORY_CHANGED_AFTER_PLAN_COMMIT",
    "FROZEN_TEST_WORKFLOW_CHANGED_AFTER_PLAN_COMMIT",
    "RUN_SHA_MISMATCH",
    "RUN_ATTEMPT_MISMATCH",
    "UNVERIFIED_GITHUB_RUN"
  ]
}
